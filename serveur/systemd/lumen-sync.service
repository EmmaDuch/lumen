[Unit]
Description=LUMEN - mise à jour du catalogue et du guide
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lumen
Group=lumen
WorkingDirectory=/opt/lumen
ExecStart=/usr/bin/python3 -m lumen.sync
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lumen
ProtectHome=true
PrivateTmp=true
